{
  "name": "shenkar-approval-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Applies approved alumni data changes from monday.com",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "dev": "concurrently -n server,tunnel -c cyan,magenta \"npm:dev:server\" \"npm:dev:tunnel\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:server": "PORT=3000 tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:tunnel": "mapps tunnel:create -p 3000",
    "deploy": "npm run build && mapps code:push"
  },
  "dependencies": {
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@mondaycom/apps-cli": "^4.11.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.2.5",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
