# monday personal/API token with read+write on the 7 boards (never commit the real value)
MONDAY_API_TOKEN=
MONDAY_API_VERSION=2025-10
# Optional shared secret appended to the webhook URL as ?token=...  (>= 24 chars, e.g. `openssl rand -hex 24`).
# Leave empty for an open webhook endpoint (events only enqueue an id; everything is re-verified in monday).
WEBHOOK_TOKEN=
# Optional: monday app signing secret, enables JWT verification for integration-app webhooks
MONDAY_SIGNING_SECRET=
# Optional: enables /admin endpoints (>= 24 chars)
ADMIN_TOKEN=
DB_PATH=./data/state.sqlite
PORT=3000
# Safe default. Live writes only when this is exactly "false".
DRY_RUN=true
LEASE_SECONDS=120
MAX_ATTEMPTS=5
DEFAULT_PHONE_COUNTRY=IL
LOG_LEVEL=info
